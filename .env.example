# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true
# Keep false until Firebase MFA is enabled and tested for this project.
NEXT_PUBLIC_MFA_ENABLED=false
# Server-side release assertion; must match the Firebase console project state.
FIREBASE_MFA_PROJECT_ENABLED=false
# Enforce MFA for admin routes only after Firebase MFA is enabled and tested.
ADMIN_MFA_ENFORCED=false
# Admin Command Grid rollout. The public flag selects the new shell; mutations remain separately locked.
NEXT_PUBLIC_ADMIN_COMMAND_GRID_V2=false
ADMIN_MUTATIONS_V2_ENABLED=false
# Enable only after a second active owner and recovery procedure are verified.
ADMIN_RECOVERY_OWNERS_VERIFIED=false
# Dedicated random HMAC secret for opaque Admin evidence references.
ADMIN_REFERENCE_SECRET=replace_with_a_unique_random_secret_of_at_least_32_characters
USER_OBSERVABILITY_V1_ENABLED=false
OBSERVABILITY_NOTICE_VERSION=observability-privacy-v1
OBSERVABILITY_RETENTION_POLICY_APPROVED=false
OBSERVABILITY_RETENTION_POLICY_VERSION=unapproved-v1
OBSERVABILITY_RETENTION_DAYS=7
OBSERVABILITY_CASE_RETENTION_DAYS=30
OBSERVABILITY_ACCESS_AUDIT_RETENTION_DAYS=30
OBSERVABILITY_RESET_JOB_RETENTION_DAYS=30
OBSERVABILITY_DAILY_SHARDS=16
OBSERVABILITY_HMAC_ACTIVE_VERSION=dev-v1
OBSERVABILITY_HMAC_KEYS_JSON={"dev-v1":"replace_with_a_managed_random_secret_of_at_least_32_characters"}
OBSERVABILITY_CURSOR_SECRET=replace_with_a_different_managed_random_secret_of_at_least_32_characters
OBSERVABILITY_RETAINED_KEY_VERSIONS_JSON=["dev-v1"]

# AI (Server-side only — NOT exposed to client)
GROQ_API_KEY=gsk_your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key

# Enterprise email delivery, signed receipts, and account actions
RESEND_API_KEY=re_your_resend_api_key
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_secret
EMAIL_SYSTEM_V2_ENABLED=false
EMAIL_MARKETING_ENABLED=false
EMAIL_AUTH_ACTION_ORIGIN=https://talentconsulting.io
# All transactional identities use the verified root domain on the current one-domain Resend plan.
EMAIL_FROM_SECURITY=TalentConsulting Security <security@talentconsulting.io>
EMAIL_FROM_ACCOUNT=TalentConsulting <account@talentconsulting.io>
EMAIL_FROM_BILLING=TalentConsulting Billing <billing@talentconsulting.io>
EMAIL_FROM_TACO=Taco at TalentConsulting <taco@talentconsulting.io>
EMAIL_FROM_SUPPORT=TalentConsulting Support <support@talentconsulting.io>
EMAIL_FROM_OPERATIONS=TalentConsulting Operations <operations@talentconsulting.io>
# Reserved only. Marketing remains disabled until separately approved.
EMAIL_FROM_MARKETING=TalentConsulting <updates@news.talentconsulting.io>
EMAIL_SUPPORT_REPLY_TO=support@talentconsulting.io
EMAIL_OPS_REPLY_TO=ops@talentconsulting.io
# Social links appear only in welcome, Taco/product, and approved marketing emails.
# Keep disabled until each configured profile is live and uses the official TalentConsulting identity.
EMAIL_SOCIAL_LINKS_ENABLED=false
EMAIL_SOCIAL_X_URL=
EMAIL_SOCIAL_BLUESKY_URL=
EMAIL_SOCIAL_REDDIT_URL=
# Private owner-controlled destination; never expose this address in source or email content.
EMAIL_OPS_DESTINATION=
EMAIL_UNSUBSCRIBE_SECRET=replace_with_a_unique_random_secret_of_at_least_32_characters
ACCOUNT_ACTION_SECRET=replace_with_a_different_random_secret_of_at_least_32_characters
CRON_SECRET=replace_with_a_third_random_secret_of_at_least_32_characters
# Leave blank while marketing is disabled. A real postal address is required before launch.
EMAIL_MAILING_ADDRESS=
TACO_PREFLIGHT_SECRET=use_a_unique_random_secret_of_at_least_24_characters
# Legacy fallback during the Taco migration; leave unset for new deployments.
SONA_PREFLIGHT_SECRET=
NEXT_PUBLIC_TACO_ROLLOUT_ENABLED=true
TACO_ROLLOUT_PHASE=general

# Voice Mode Configuration
DEEPGRAM_API_KEY=your_deepgram_api_key

# Internal Ever Jobs supply service
EVER_JOBS_ENABLED=false
EVER_JOBS_API_URL=http://localhost:3001
EVER_JOBS_API_KEY=
EVER_JOBS_SAFE_SOURCES=remoteok,remotive,jobicy,himalayas,weworkremotely
# Permit plain HTTP only to a single-label private Docker service name.
EVER_JOBS_ALLOW_PRIVATE_HTTP=false

# DashScope (Alibaba Cloud) — CosyVoice TTS
DASHSCOPE_API_KEY=your_dashscope_api_key
DASHSCOPE_TTS_MODEL=cosyvoice-v3-flash
DASHSCOPE_WS_URL=wss://dashscope-intl.aliyuncs.com/api-ws/v1/inference

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRO_PRICE_ID=price_your_pro_price_id
STRIPE_PRO_ANNUAL_PRICE_ID=price_your_pro_annual_price_id
STRIPE_STUDIO_PRICE_ID=price_your_studio_price_id
STRIPE_STUDIO_ANNUAL_PRICE_ID=price_your_studio_annual_price_id
STRIPE_PRO_PROMOTION_CODE_ID=promo_your_standard_founding_code_id
STRIPE_STUDIO_PROMOTION_CODE_ID=promo_your_max_founding_code_id

# Server-owned promotion ceiling. Verify active Stripe promotions before changing.
# Admin Finance fails closed when the live inventory exceeds this value.
STRIPE_MAX_PROMOTION_DISCOUNT_PERCENT=25
