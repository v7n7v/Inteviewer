# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage
/.seo-audit
/.security-cve
/email-previews

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# Backups and copies of the secret-bearing env files. `.env*.local` above only
# matches names that END in `.local`, so `.env.local.bak.1785877071` was
# commit-eligible with live Stripe keys in it. Anything derived from .env.local
# carries the same secrets and must be ignored too.
.env.local.*
.env*.bak*
.env*.orig
.env*.save

# secrets & credentials
*.key
*serviceAccount*.json
hermes-agent-keys.txt

# vercel
.vercel

# firebase
.firebase
firebase-debug.log
firebase-debug.*.log
firestore-debug.log

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE
.vscode
.idea
*.swp
*.swo
*~

# Old files
index.html
neuralhire.html
YOUR_CREDENTIALS.txt

# Cloud Run
.env.cloudrun.yaml

# recovery artefacts (25 July 2026) — not source
/_backup
/_to_delete

# QA / audit output — regenerable, ~412 MB, never source
/output
/test-results
/.playwright-cli

# recovery/tooling artefacts
/_to_delete
/.ui-verify

# Installed skills. Source of truth is docs/claude-skills/ (tracked);
# .claude/skills is the local install target, per docs/claude-skills/README.md.
# Tracking both would let the two copies diverge silently.
/.claude
